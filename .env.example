# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR COLLEGE EVENT REGISTRATION SYSTEM
# Duplicate this file as '.env' and fill in your values
# ==============================================================================

# Server Port
PORT=5000

# PostgreSQL Connection String (EXCLUSIVELY PostgreSQL - No MongoDB)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_events

# Set to true if connecting to cloud-hosted PostgreSQL (Neon, Supabase, Render, Aiven)
DATABASE_SSL=false

# JSON Web Token Secret Key
JWT_SECRET=supersecret_jwt_key_college_events_2026_change_in_production

# Application Environment (development, test, production)
NODE_ENV=development
